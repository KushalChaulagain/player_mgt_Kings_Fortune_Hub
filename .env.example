# Copy to .env.local and fill in. Never commit .env.local.

# From the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab name at the bottom of the spreadsheet
GOOGLE_SHEET_TAB=Master Sheet


# From the service account JSON key: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the service account JSON key: "private_key".
# Keep the surrounding quotes and the literal \n sequences exactly as in the JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Master shop setup key typed once on an authorized phone during device binding.
# Treat this like a physical safe combination. Do not reuse a weak password.
DEVICE_SETUP_SECRET=

# HMAC secret for the 10-year device_bound_token cookie. Optional; falls back to DEVICE_SETUP_SECRET.
# Use a long random string in production (openssl rand -hex 32).
DEVICE_TOKEN_SECRET=
